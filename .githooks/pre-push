#!/bin/sh
# .githooks/pre-push
#
# Guards the PUBLIC remote (speedgoatgmbh) – only website-essential files are
# allowed.  Research artefacts, docs, crawl outputs, and internal tooling must
# stay on the private/internal remote.
#
# Runs automatically on `git push`.  Install with:
#   npm run setup:hooks   (or: git config core.hooksPath .githooks)
#
# The check is SKIPPED automatically for any remote that is not speedgoatgmbh,
# so pushes to the private/internal remote are never affected.

remote="$1"
url="$2"

# ── scope guard: skip if not speedgoatgmbh ────────────────────────────────────
case "$url" in
  *speedgoatgmbh*) ;;
  *) exit 0 ;;
esac

echo ""
echo ">> Public remote (speedgoatgmbh) detected – checking website-essential policy..."

# ── read pushed ref ranges from stdin ─────────────────────────────────────────
found_violation=0

while read local_ref local_sha remote_ref remote_sha; do
  # Branch deletion – nothing to check.
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch: compare against the empty tree so we see all files.
    empty_tree=$(git hash-object -t tree /dev/null)
    files=$(git diff --name-only "$empty_tree" "$local_sha" 2>/dev/null)
  else
    files=$(git diff --name-only "$remote_sha" "$local_sha")
  fi

  if [ -n "$files" ]; then
    echo "$files" | node scripts/check-website-essential.mjs
    result=$?
    if [ "$result" -ne 0 ]; then
      found_violation=1
    fi
  fi
done

if [ "$found_violation" -ne 0 ]; then
  exit 1
fi

echo ">> Policy check passed."
exit 0
